model User {
  id             String     @id @default(cuid())
  email          String     @unique
  displayName    String
  avatarUrl      String?
  googleId       String     @unique
  // Jetons OAuth YouTube (scope youtube.readonly) pour importer les playlists du compte.
  // NB prod : à chiffrer au repos (hors périmètre école).
  ytAccessToken  String?    @db.Text
  ytRefreshToken String?    @db.Text
  ytTokenExpiry  DateTime?
  // Starting settings of every NEW note (YC-48): paper, tint, margin, timestamps, font, size,
  // validated by src/lib/notePage.ts. Copied into a note when it is created; null = the defaults.
  notePreferences Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  playlists      Playlist[]
  notes          Note[]
  progress       Progress[]
  libraryVideos  LibraryVideo[]
  noteImages     NoteImage[]
}
