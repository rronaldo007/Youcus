model Video {
  id              String     @id @default(cuid())
  youtubeId       String
  title           String
  durationSeconds Int        @default(0)
  position        Int        @default(0)
  thumbnailUrl    String?
  playlist        Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId      String
  notes           Note[]
  progress        Progress[]

  @@index([playlistId])
}
