model Video {
  id              String          @id @default(cuid())
  // Décision CS-70 (25/07) : la vidéo est partagée entre playlists, une seule ligne par vidéo YouTube.
  youtubeId       String          @unique
  title           String
  durationSeconds Int             @default(0)
  thumbnailUrl    String?
  playlists       PlaylistVideo[]
  notes           Note[]
  progress        Progress[]
}
