// Schema Prisma Youcus (stub initial, CS-33).
// provider mysql : compatible MySQL 8 (dev) et MariaDB (prod Sevalla).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  displayName  String
  avatarUrl    String?
  googleId     String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  playlists    Playlist[]
  notes        Note[]
  progress     Progress[]
}

model Playlist {
  id           String     @id @default(cuid())
  youtubeId    String
  title        String
  description  String?    @db.Text
  thumbnailUrl String?
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  videos       Video[]
  notes        Note[]
  progress     Progress[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([ownerId, youtubeId])
  @@index([ownerId])
}

model Video {
  id              String     @id @default(cuid())
  youtubeId       String
  title           String
  durationSeconds Int        @default(0)
  position        Int        @default(0)
  thumbnailUrl    String?
  playlist        Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId      String
  notes           Note[]
  progress        Progress[]

  @@index([playlistId])
}

model Note {
  id         String    @id @default(cuid())
  content    String    @db.Text
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  // Une note est attachee soit a une video, soit a une playlist (F9 vs F16).
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId    String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([authorId, videoId])
  @@unique([authorId, playlistId])
  @@index([authorId])
}

model Progress {
  id             String   @id @default(cuid())
  watchedSeconds Int      @default(0)
  completed      Boolean  @default(false)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId        String
  playlist       Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId     String
  updatedAt      DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId, playlistId])
}
