{
  "name": "@youcus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Back Youcus (Express, TypeScript, Prisma).",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "metadata:refresh": "tsx src/jobs/refreshMetadata.cli.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@prisma/client": "^5.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "marked": "^18.0.14",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.12.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.20.0",
    "supertest": "^7.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.2"
  }
}
