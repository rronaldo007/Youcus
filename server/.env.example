NODE_ENV=development
PORT=4000

# Prisma / MySQL (aligne sur docker-compose)
DATABASE_URL="mysql://youcus:youcus@localhost:3306/youcus"

# Origine autorisee pour CORS (client Vite)
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth 2.0 (a renseigner)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Secret de session (32+ caracteres)
SESSION_SECRET=change-me-in-production
