NODE_ENV=development
PORT=4000

# Prisma / MySQL (aligne sur docker-compose)
DATABASE_URL="mysql://youcus:youcus@localhost:3306/youcus"

# Origine autorisee pour CORS (client Vite)
CLIENT_ORIGIN=http://localhost:5173

# Built client served by the API itself (YC-11): one origin, first-party session cookie.
# Set by server/Dockerfile (/app/client/dist). Leave empty in dev: Vite serves the client.
# In production, CLIENT_ORIGIN and GOOGLE_CALLBACK_URL then use the API's own address.
# CLIENT_DIST=/app/client/dist

# Session cookie SameSite (YC-11): unset = none in production, lax elsewhere.
# Set to lax once no public link points to the old front address any more.
# SESSION_SAMESITE=lax

# Extra origins allowed by CORS, comma-separated (YC-35), e.g. the old front address.
# CORS_EXTRA_ORIGINS=https://old-front.example

# Google OAuth 2.0 (a renseigner)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Secret de session (32+ caracteres)
SESSION_SECRET=change-me-in-production

# YouTube Data API v3 (import de playlists, CS-11)
YOUTUBE_API_KEY=
# Rafraichissement quotidien des metadonnees YouTube (regle des 30 jours, YC-8) : on | off
METADATA_REFRESH=on

# Utilisateur de seed (developpement)
SEED_USER_EMAIL=demo@youcus.fr
SEED_USER_NAME=Utilisateur démo
SEED_USER_GOOGLE_ID=seed-google-id

# Cache NoSQL (CS-67). OPTIONNEL : sans cette variable, les metadonnees YouTube
# sont lues directement depuis l'API a chaque import. En Docker : redis://cache:6379
REDIS_URL=

# Object storage of the note images (YC-50). Production: Sevalla object storage (its S3
# endpoint, bucket and keys). Local: the MinIO of docker compose (values below). Unset: no images.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=youcus-notes
S3_ACCESS_KEY_ID=youcus
S3_SECRET_ACCESS_KEY=youcus-dev-secret
S3_FORCE_PATH_STYLE=true
