{
  "name": "youcus",
  "version": "0.1.0",
  "private": true,
  "description": "Youcus : une couche d'etude sur YouTube (lecteur sans distraction, notes Markdown synchronisees, suivi de progression).",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "stack": "docker compose up",
    "stack:build": "docker compose up --build"
  }
}
