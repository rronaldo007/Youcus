# Profil de la stack Docker Compose : "dev" (hot-reload) ou "prod" (images buildees).
# Lu automatiquement par `docker compose`. C'est LE toggle dev <-> prod.
#   docker compose up   ->  db + api-dev + web-dev   (si dev)
#   docker compose up   ->  db + api     + web       (si prod)
COMPOSE_PROFILES=dev

# Base de donnees MySQL (developpement, utilisee par docker-compose)
MYSQL_DATABASE=youcus
MYSQL_USER=youcus
MYSQL_PASSWORD=youcus
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Origine du client (CORS) et secret de session cote serveur
CLIENT_ORIGIN=http://localhost:8080
SESSION_SECRET=change-me-in-production

# Google OAuth et cle YouTube : renseignes dans server/.env (voir server/.env.example).
# Le conteneur api-dev charge automatiquement server/.env (env_file), pas besoin
# de dupliquer GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_CALLBACK_URL /
# YOUTUBE_API_KEY ici.

# Chaine de connexion utilisee par le serveur (Prisma)
# DATABASE_URL="mysql://youcus:youcus@localhost:3306/youcus"

# Ports hote (dev) - changer si conflit local
API_PORT=4000
WEB_PORT=8080
